# BMW oap-sdk is extracted from the owner's head unit and is not redistributable.
oap-sdk/
**/node_modules/oap-sdk/

# Built packages contain the SDK when linked on a machine that has a donor.
dist/
*.mgu
*.tgz
native/g21-airplay-open/build/
native/g21-airplay-open/avahi-extract/

# Vehicle and credential material. Never commit these.
*.7z
data.7z
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa
connect.txt
data/enrollments/
known_hosts

# Local head-unit copies used only for signal checks.
reference/
preview/
*.log
node_modules/

# Developer SSH cycle artifacts (never commit HU logs / staging).
dev-logs/
dev-staging/
