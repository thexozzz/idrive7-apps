{
  "name": "g21_hello",
  "version": "0.1.1",
  "description": "Szablon aplikacji iDrive 7. Ekran statusu na centralnym wyświetlaczu. Nie zapisuje do sterowników.",
  "private": false,
  "main": "javascript/runner.js",
  "oapAppSettings": {
    "maxDiskUsage": 10485760,
    "cpuLimit": 10,
    "memoryThresholdKB": 65536,
    "priority": "PRIO_MEDIUM",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "HELO",
    "userLoginRequired": false,
    "backgroundPriority": 150,
    "someipManifest": "manifest.json"
  },
  "files": [
    "config",
    "rhmiData",
    "package.json",
    "npm-shrinkwrap.json",
    "permissions.json",
    "javascript",
    "manifest.json",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "oap-sdk": "24.10.2"
  },
  "engines": {
    "node": ">=8.7.0"
  },
  "license": "MIT",
  "mguLocalOnly": true,
  "mguHmi": [
    "ID7"
  ]
}
