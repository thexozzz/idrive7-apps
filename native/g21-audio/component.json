{
  "id": "g21-audio",
  "kind": "tool",
  "version": "0.1.4",
  "license": "GPL-3.0-or-later",
  "title": "G21 Audio",
  "description": "Dźwięk THEiPlay na głośnikach auta: strumień PCM przez SmartX (CarLifeMedia) i AudioManager BMW, z głośnością iDrive. Sterowanie przez /run/g21-audio/ctl.sock.",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "mguHmi": [
    "ID7"
  ],
  "files": [
    { "path": "LICENSE", "mode": "0644" },
    { "path": "NOTICE.md", "mode": "0644" },
    { "path": "check.sh", "mode": "0755" },
    { "path": "g21-audio-client.js", "mode": "0644" },
    { "path": "g21-audio-out", "mode": "0755" },
    { "path": "g21-audiod.js", "mode": "0644" },
    { "path": "speakers.js", "mode": "0644" }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "g21-audio.service",
      "from": "g21-audio.service"
    }
  ],
  "enable": [
    {
      "unit": "g21-audio.service",
      "target": "multi-user.target"
    }
  ],
  "crashNames": [
    "g21-audio-out"
  ],
  "recmgr": [
    "g21-audio"
  ],
  "restart": [
    "g21-audio.service"
  ]
}
