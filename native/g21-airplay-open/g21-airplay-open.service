# AirPlay on the car Wi-Fi AP / shared Wi-Fi (g21-airplay-open)
[Unit]
Description=AirPlay on car Wi-Fi (g21-airplay-open)
RequiresMountsFor=/var/opt
After=winston.service
StartLimitIntervalSec=0

[Service]
SupplementaryGroups=video
Environment=XDG_RUNTIME_DIR=/run/wayland
ExecStart=/var/opt/g21-airplay-open/current/g21-airplay-open
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
