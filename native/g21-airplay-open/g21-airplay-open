#!/bin/sh
# AirPlay receiver integration for g21_airplay — not a standalone UxPlay app.
# Starts the bundled AirPlay engine (UxPlay binary, GPL-3.0) on the Wi-Fi that
# MGU Store uses, including an iPhone Personal Hotspot host. The phone can be
# the AP; the head unit is the AirPlay sink on that LAN.
#
# DNS-SD needs a running avahi-daemon (bundled next to this script when the
# unit has none). Without it the receiver cannot register and the phone never sees G21.
#
# Inbound accept, only from that lease subnet and only on that interface:
# UDP 5353 (mDNS, also 224.0.0.251) and UxPlay -p 7400 block.
# On this MGU CarPlay already owns TCP 7000 and airplay-rx owns 7101;
# legacy UxPlay ports (7100/7000/7001) fail with errno 98 (EADDRINUSE).
# -p 7400 uses TCP/UDP 7400-7402 (httpd listens on TCP 7401).
set -u

TABLE=g21_airplay
STATUS=/run/mgu-uplink/status.json
LEASE=/run/mgu-uplink/lease.json
STAMP=/run/g21-airplay.stamp
REPORT=/run/g21-airplay.status
SESSION_DIR=/run/g21-session
ALLOW=$SESSION_DIR/allow
DESKTOP=/run/g21-desktop.status
UXLOG=/var/log/g21-uxplay.log
PINFILE=/run/g21-airplay/pin
UXPID=
PINWATCH=
PREPID=
RDPID=
MICEPID=
AVAHIPID=

field() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" "$2" | head -n 1
}

number() {
    sed -n "s/.*\"$1\"[[:space:]]*:[[:space:]]*\\([0-9][0-9]*\\).*/\\1/p" "$2" | head -n 1
}

subnet() {
    awk -v ip="$1" -v prefix="$2" 'BEGIN {
        n = split(ip, o, ".")
        if (n != 4 || prefix < 1 || prefix > 32) exit 1
        for (i = 1; i <= 4; i++) if (o[i] < 0 || o[i] > 255) exit 1
        acc = o[1] * 16777216 + o[2] * 65536 + o[3] * 256 + o[4]
        shift = 32 - prefix
        if (shift > 0) {
            size = 1
            for (i = 0; i < shift; i++) size *= 2
            acc = int(acc / size) * size
        }
        printf "%d.%d.%d.%d/%d\n", int(acc / 16777216) % 256, int(acc / 65536) % 256, int(acc / 256) % 256, acc % 256, prefix
    }'
}

find_ux() {
    if [ -n "${UXPLAY:-}" ] && [ -x "$UXPLAY" ]; then
        printf '%s\n' "$UXPLAY"
        return 0
    fi
    dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
    if [ -x "$dir/uxplay" ]; then
        printf '%s\n' "$dir/uxplay"
        return 0
    fi
    command -v uxplay 2>/dev/null
}

tool_dir() {
    CDPATH= cd -- "$(dirname "$0")" && pwd
}

report() {
    printf '%s\n' "$1" > "$REPORT"
    chmod 666 "$REPORT" 2>/dev/null || true
}

desk() {
    # World-writable: OAP app (uid 12249) must update this file; root 644 → EACCES → connect-failed.
    printf '%s\n' "$1" > "$DESKTOP"
    chmod 666 "$DESKTOP" 2>/dev/null || true
}

# nftables accept in our table does NOT stop mgu_uplink drop (separate base
# chain). Rules must live in inet mgu_uplink itself, tagged by comment.
clear_uplink_airplay_rules() {
    for chain in output input; do
        nft -a list chain inet mgu_uplink "$chain" 2>/dev/null | grep 'g21-airplay' | while read -r line; do
            h=$(printf '%s\n' "$line" | sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p')
            if [ -n "$h" ]; then
                nft delete rule inet mgu_uplink "$chain" handle "$h" 2>/dev/null || true
            fi
        done
    done
}

clear_table() {
    if [ -f /run/g21-airplay/mdns-iface ]; then
        old_iface=$(tr -d '\r\n' < /run/g21-airplay/mdns-iface 2>/dev/null || true)
        if [ -n "$old_iface" ]; then
            ip route del 224.0.0.251/32 dev "$old_iface" 2>/dev/null || true
        fi
        rm -f /run/g21-airplay/mdns-iface
    fi
    clear_uplink_airplay_rules
    nft delete table inet "$TABLE" 2>/dev/null || true
}

# Path-qualified stops only — never killall / bare pkill names.
our_uxplay_pids() {
    pgrep -f '/var/opt/g21-airplay-open/.*/uxplay.bin' 2>/dev/null || true
}

our_avahi_pids() {
    # run-elf keeps the path in argv; after ready, avahi rewrites cmdline to
    # "avahi-daemon: running […]". Match both, then confirm our private libs.
    pids=$(pgrep -f '/var/opt/g21-airplay-open/.*/avahi-daemon' 2>/dev/null || true)
    pids="$pids $(pgrep -f 'avahi-daemon: running' 2>/dev/null || true)"
    for p in $pids; do
        [ -r "/proc/$p/maps" ] || continue
        if grep -q '/var/opt/g21-airplay-open/.*/libavahi' "/proc/$p/maps" 2>/dev/null; then
            printf '%s\n' "$p"
        fi
    done
}

clear_pin() {
    if [ -n "$PINWATCH" ]; then
        kill "$PINWATCH" 2>/dev/null || true
        PINWATCH=
    fi
    rm -f "$PINFILE"
}

# fakesink cannot show UxPlay's GST PIN image. Never truncate PINFILE here —
# start_ux already wrote the session code; only refresh if the log shows a new one.
watch_ux_pin() {
    pid=$1
    last=
    mkdir -p /run/g21-airplay
    if [ -f "$PINFILE" ]; then
        last=$(tr -d '\n' < "$PINFILE" 2>/dev/null || true)
    fi
    chmod 666 "$PINFILE" 2>/dev/null || true
    while kill -0 "$pid" 2>/dev/null; do
        pin=$(sed -n 's/.*CLIENT MUST NOW ENTER PIN = "\([0-9][0-9][0-9][0-9]\)".*/\1/p' "$UXLOG" 2>/dev/null | tail -n 1)
        if [ -n "$pin" ] && [ "$pin" != "$last" ]; then
            printf '%s\n' "$pin" > "$PINFILE"
            last=$pin
        fi
        sleep 1
    done
}

stop_ux() {
    clear_pin
    if [ -n "$UXPID" ]; then
        kill "$UXPID" 2>/dev/null || true
        UXPID=
    fi
    # Orphans keep AirPlay TCP/UDP ports (errno 98) and block the next start.
    for p in $(our_uxplay_pids); do
        kill "$p" 2>/dev/null || true
    done
}

stop_avahi_local() {
    if [ -n "$AVAHIPID" ]; then
        kill "$AVAHIPID" 2>/dev/null || true
        AVAHIPID=
    fi
}

stop_bundled_avahi() {
    stop_avahi_local
    for p in $(our_avahi_pids); do
        kill "$p" 2>/dev/null || true
    done
    AVAHIPID=
}

# MGU ships Apple mdnsd + /usr/lib/libdns_sd.so; UxPlay dlopens libdns_sd.so.
have_system_mdns() {
    if ! pidof mdnsd >/dev/null 2>&1; then
        return 1
    fi
    if [ -e /usr/lib/libdns_sd.so ] || [ -e /lib/libdns_sd.so ]; then
        return 0
    fi
    return 1
}

ux_port_listening() {
    # UxPlay "-p 7400" maps tcp[0]=7400 (mirror data), tcp[1]=7401 (RAOP/AirPlay
    # httpd), tcp[2]=7402. The process listens on TCP 7401 while advertising; 7400
    # may appear only after a client starts mirroring. Health must accept 7401.
    if netstat -lnt 2>/dev/null | grep -E '[:.]740[01][[:space:]]' >/dev/null 2>&1; then
        return 0
    fi
    if ss -lnt 2>/dev/null | grep -E '[:.]740[01][[:space:]]' >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

ux_log_stopped() {
    if [ ! -f "$UXLOG" ]; then
        return 1
    fi
    grep -E 'Stopping RAOP Server|GStreamer error' "$UXLOG" >/dev/null 2>&1
}

# Drop Windows Miracast DNS-SD only when a leftover service file exists.
clear_mice_if_needed() {
    if [ -n "$MICEPID" ] && kill -0 "$MICEPID" 2>/dev/null; then
        stop_mice
        clear_mice_service
        return 0
    fi
    if [ -f /run/g21-airplay/avahi-etc-services/g21-windows.service ] || \
       [ -f /etc/avahi/services/g21-windows.service ]; then
        clear_mice_service
    fi
}

clear_mice_offers() {
    rm -f /run/g21-desktop/offers /run/g21-session/accept /run/g21-session/reject 2>/dev/null || true
}

idle() {
    stop_ux
    stop_present
    stop_rdp
    stop_mice
    clear_mice_service
    clear_mice_offers
    stop_bundled_avahi
    if [ -f "$STAMP" ]; then
        clear_table
        rm -f "$STAMP"
    fi
}

open_ports() {
    iface=$1
    net=$2
    ipaddr=${3:-}
    mkdir -p /run/g21-airplay
    # BMW routes 224.0.0.0/4 via vlan73; without a /32 on the Store Wi-Fi
    # iface, avahi announces mDNS on the wrong interface and iPhone sees nothing.
    if [ -f /run/g21-airplay/mdns-iface ]; then
        old_iface=$(tr -d '\r\n' < /run/g21-airplay/mdns-iface 2>/dev/null || true)
        if [ -n "$old_iface" ] && [ "$old_iface" != "$iface" ]; then
            ip route del 224.0.0.251/32 dev "$old_iface" 2>/dev/null || true
        fi
    fi
    printf '%s\n' "$iface" > /run/g21-airplay/mdns-iface
    ip route replace 224.0.0.251/32 dev "$iface" 2>/dev/null || true
    # Store Wi-Fi can have an address with NO connected route (policy routing).
    # Then AirPlay TCP SYN from the phone arrives, but SYN-ACK never leaves —
    # iPhone never reaches the password prompt. Force the lease subnet on-link.
    if [ -n "$net" ] && [ -n "$ipaddr" ]; then
        ip route replace "$net" dev "$iface" src "$ipaddr" 2>/dev/null || \
            ip route add "$net" dev "$iface" src "$ipaddr" 2>/dev/null || true
    fi
    # Own table (audit / belt-and-suspenders). Real allow must be in mgu_uplink:
    # that table drops root egress/ingress on Store Wi-Fi, and nft accept in
    # another table does not override it.
    nft -f - <<EOF
add table inet $TABLE
delete table inet $TABLE
table inet $TABLE {
    chain input {
        type filter hook input priority -10; policy accept;
        iifname "$iface" ip daddr 224.0.0.251 udp dport 5353 accept
        iifname "$iface" ip saddr $net udp dport 5353 accept
        iifname "$iface" ip saddr $net tcp dport 7400-7402 accept
        iifname "$iface" ip saddr $net udp dport 7400-7402 accept
        iifname "$iface" ip saddr $net tcp dport 1235 accept
        iifname "$iface" ip saddr $net tcp dport 7250 accept
        iifname "$iface" ip saddr $net udp dport 1028 accept
        iifname "$iface" ip saddr $net udp dport 1029 accept
    }
    chain output {
        type filter hook output priority -50; policy accept;
        oifname "$iface" ip daddr 224.0.0.251 udp dport 5353 accept
        oifname "$iface" ip daddr $net udp dport 5353 accept
        oifname "$iface" udp sport 5353 accept
        oifname "$iface" tcp sport 7400-7402 accept
        oifname "$iface" udp sport 7400-7402 accept
        oifname "$iface" ip daddr $net accept
    }
}
EOF
    clear_uplink_airplay_rules
    # insert = head of chain, before skuid allow / drop.
    nft insert rule inet mgu_uplink output oifname "$iface" ip daddr 224.0.0.251 udp dport 5353 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink output oifname "$iface" ip daddr "$net" udp dport 5353 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink output oifname "$iface" udp sport 5353 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink output oifname "$iface" tcp sport 7400-7402 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink output oifname "$iface" udp sport 7400-7402 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink output oifname "$iface" ip daddr "$net" accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip daddr 224.0.0.251 udp dport 5353 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" udp dport 5353 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" tcp dport 7400-7402 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" udp dport 7400-7402 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" tcp dport 1235 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" tcp dport 7250 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" udp dport 1028 accept comment \"g21-airplay\" 2>/dev/null || true
    nft insert rule inet mgu_uplink input iifname "$iface" ip saddr "$net" udp dport 1029 accept comment \"g21-airplay\" 2>/dev/null || true
}

# Tailscale on MGU is userspace-only: no kernel route to 100.64/10.
# Opt-in SOCKS5 on 127.0.0.2 lets RDP/VNC reach the tailnet.
ensure_tailscale_socks5() {
    tsroot=/var/opt/iteriodev-tailscale
    portfile=$tsroot/socks5-port
    port=1055
    porthex=
    if [ ! -d "$tsroot" ]; then
        return 0
    fi
    if [ ! -f "$portfile" ]; then
        printf '%s\n' "$port" > "$portfile"
        chmod 644 "$portfile" 2>/dev/null || true
    fi
    port=$(tr -d ' \t\r\n' < "$portfile" 2>/dev/null || true)
    case $port in
        ''|*[!0-9]*) port=1055; printf '%s\n' "$port" > "$portfile" ;;
    esac
    export G21_SOCKS5_HOST=127.0.0.2
    export G21_SOCKS5_PORT=$port
    printf '%s\n' "$port" > "$SESSION_DIR/socks5-port"
    chmod 666 "$SESSION_DIR/socks5-port" 2>/dev/null || true
    # 127.0.0.2 = 0200007F in /proc/net/tcp; listen state 0A.
    porthex=$(printf '%04X' "$port")
    if grep -qiE " 0200007F:${porthex} .* 0A " /proc/net/tcp 2>/dev/null; then
        return 0
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl restart iteriodev-tailscale.service >/dev/null 2>&1 || true
        sleep 2
    fi
    return 0
}

ensure_dirs() {
    mkdir -p "$SESSION_DIR" /run/g21-desktop /run/g21-airplay
    chmod 1777 "$SESSION_DIR" /run/g21-desktop 2>/dev/null || true
    # Keep status files writable by the Store app after root/tool updates.
    : >> "$DESKTOP"
    : >> "$REPORT"
    chmod 666 "$DESKTOP" "$REPORT" 2>/dev/null || true
    ensure_tailscale_socks5
}

mode_of() {
    if [ -f "$ALLOW" ]; then
        tr -d '\r\n' < "$ALLOW"
    fi
}

name_of() {
    name=G21
    if [ -f "$SESSION_DIR/name" ]; then
        name=$(tr -d '\r\n' < "$SESSION_DIR/name")
    fi
    case $name in
        ""|*[!A-Za-z0-9_-]*) name=G21 ;;
    esac
    printf '%s\n' "$name"
}

stop_pid() {
    pid=$1
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
    fi
}

# Reset path each start — appending every apply() blew past ARG_MAX on run-elf.
tool_lib_path() {
    dir=$(tool_dir)
    printf '%s\n' "$dir/lib:/usr/lib:/lib"
}

wait_pid_gone() {
    pid=$1
    n=0
    while [ -n "$pid" ] && [ "$n" -lt 20 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
        sleep 0.1
        n=$((n + 1))
    done
    if [ -n "$pid" ]; then
        kill -9 "$pid" 2>/dev/null || true
    fi
}

# True when nothing is bound to frame.sock (stale file alone is OK after unlink).
frame_sock_free() {
    # If a live g21-present still holds the bind, bridge gets EADDRINUSE.
    if pgrep -f '/g21-present' >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

# Prints: iface ip prefix label
find_uplink_wifi() {
    kind=$(field kind "$STATUS")
    link=$(field link "$STATUS")
    iface=$(field interface "$LEASE")
    ip=$(field ip "$LEASE")
    prefix=$(number prefix "$LEASE")
    ssid=$(field ssid "$STATUS")
    case $kind in
        wifi) ;;
        *) return 1 ;;
    esac
    case $link in
        online|connected) ;;
        *) return 1 ;;
    esac
    case $iface in
        ""|*[!A-Za-z0-9._-]*) return 1 ;;
    esac
    case $prefix in
        ""|*[!0-9]*) return 1 ;;
    esac
    if [ "$prefix" -lt 1 ] || [ "$prefix" -gt 32 ]; then
        return 1
    fi
    case $ssid in
        "") ssid=$iface ;;
    esac
    printf '%s %s %s %s\n' "$iface" "$ip" "$prefix" "$ssid"
}

iface_mac() {
    iface=$1
    mac=$(tr '[:upper:]' '[:lower:]' < "/sys/class/net/$iface/address" 2>/dev/null | tr -d '\r\n')
    case $mac in
        [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
            printf '%s\n' "$mac"
            ;;
    esac
}

# Rootfs is read-only; avahi still hard-requires user "avahi". Overlay passwd/group
# from /run via bind mount (cleared on reboot). Same for a D-Bus policy so
# DNSServiceRegister from UxPlay can talk to the daemon.
ensure_avahi_account() {
    mkdir -p /run/g21-airplay /run/avahi-daemon
    passwd_run=/run/g21-airplay/passwd
    group_run=/run/g21-airplay/group
    if ! grep -q ' /etc/passwd ' /proc/mounts 2>/dev/null; then
        cp /etc/passwd "$passwd_run"
        cp /etc/group "$group_run"
    fi
    if [ ! -f "$passwd_run" ]; then
        cp /etc/passwd "$passwd_run"
    fi
    if [ ! -f "$group_run" ]; then
        cp /etc/group "$group_run"
    fi
    if ! grep -q '^avahi:' "$passwd_run" 2>/dev/null; then
        echo 'avahi:x:189:189:Avahi mDNS daemon:/run/avahi-daemon:/bin/false' >> "$passwd_run"
    fi
    if ! grep -q '^avahi:' "$group_run" 2>/dev/null; then
        echo 'avahi:x:189:' >> "$group_run"
    fi
    if ! grep -q ' /etc/passwd ' /proc/mounts 2>/dev/null; then
        mount --bind "$passwd_run" /etc/passwd || return 1
    fi
    if ! grep -q ' /etc/group ' /proc/mounts 2>/dev/null; then
        mount --bind "$group_run" /etc/group || return 1
    fi
    chown 189:189 /run/avahi-daemon 2>/dev/null || true
    return 0
}

ensure_avahi_dbus() {
    src=/etc/dbus-1/system.d
    dst=/run/g21-airplay/dbus-system.d
    conf=$dst/g21-avahi.conf
    if [ ! -d "$src" ]; then
        return 0
    fi
    mkdir -p "$dst"
    if ! grep -q ' /etc/dbus-1/system.d ' /proc/mounts 2>/dev/null; then
        cp "$src"/* "$dst"/ 2>/dev/null || true
    fi
    cat > "$conf" <<'EOF'
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-BUS Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <policy user="root">
    <allow own="org.freedesktop.Avahi"/>
    <allow send_destination="org.freedesktop.Avahi"/>
    <allow receive_sender="org.freedesktop.Avahi"/>
  </policy>
  <policy user="avahi">
    <allow own="org.freedesktop.Avahi"/>
    <allow send_destination="org.freedesktop.Avahi"/>
    <allow receive_sender="org.freedesktop.Avahi"/>
  </policy>
  <policy context="default">
    <allow send_destination="org.freedesktop.Avahi"/>
    <allow receive_sender="org.freedesktop.Avahi"/>
  </policy>
</busconfig>
EOF
    if ! grep -q ' /etc/dbus-1/system.d ' /proc/mounts 2>/dev/null; then
        mount --bind "$dst" "$src" || return 1
    fi
    if command -v dbus-send >/dev/null 2>&1; then
        dbus-send --system --type=method_call --dest=org.freedesktop.DBus \
            /org/freedesktop/DBus org.freedesktop.DBus.ReloadConfig >/dev/null 2>&1 || true
    fi
    return 0
}

start_avahi_bin() {
    dir=$1
    conf=$2
    if [ -x "$dir/run-elf" ]; then
        "$dir/run-elf" "$dir/avahi-daemon" \
            --no-chroot \
            --no-drop-root \
            --no-rlimits \
            -f "$conf" \
            >>/var/log/g21-avahi.log 2>&1 &
    else
        "$dir/avahi-daemon" \
            --no-chroot \
            --no-drop-root \
            --no-rlimits \
            -f "$conf" \
            >>/var/log/g21-avahi.log 2>&1 &
    fi
    AVAHIPID=$!
    sleep 2
    if kill -0 "$AVAHIPID" 2>/dev/null; then
        return 0
    fi
    AVAHIPID=
    return 1
}

# Bundled avahi is started via run-elf — BusyBox pidof "avahi-daemon" often misses
# it (comm=ld-linux). Detect by path and recover AVAHIPID so we never double-start
# (double-start → SIGTERM storm in g21-avahi.log).
recover_avahi_pid() {
    pid=
    for pid in $(our_avahi_pids); do
        if kill -0 "$pid" 2>/dev/null; then
            AVAHIPID=$pid
            return 0
        fi
    done
    AVAHIPID=
    return 1
}

ensure_mdns() {
    iface=$1
    dir=$(tool_dir)
    export LD_LIBRARY_PATH="$(tool_lib_path)"
    if [ -n "$AVAHIPID" ] && kill -0 "$AVAHIPID" 2>/dev/null; then
        return 0
    fi
    if recover_avahi_pid; then
        return 0
    fi
    # Do NOT systemctl-start factory avahi — stay inside this tool only.
    if [ ! -x "$dir/avahi-daemon" ]; then
        return 1
    fi
    if ! ensure_avahi_account; then
        echo "g21-airplay-open: avahi account overlay failed" >>/var/log/g21-avahi.log
        return 1
    fi
    ensure_avahi_dbus || true
    conf=/run/g21-airplay/avahi-daemon.conf
    hosts=/run/g21-airplay/avahi-hosts
    services=/run/g21-airplay/avahi-services
    mkdir -p "$services"
    : > "$hosts"
    cat > "$conf" <<EOF
[server]
host-name=G21
use-ipv4=yes
use-ipv6=no
allow-interfaces=$iface
deny-interfaces=lo
enable-dbus=yes
check-response-ttl=no
use-iff-running=yes
[wide-area]
enable-wide-area=no
[publish]
disable-publishing=no
disable-user-service-publishing=no
publish-addresses=yes
publish-hinfo=no
publish-workstation=no
publish-domain=yes
publish-resolv-conf-dns-servers=no
[reflector]
enable-reflector=no
[rlimits]
EOF
    # Clear any orphan from a previous tool incarnation before bind.
    stop_bundled_avahi
    sleep 0.3
    # This avahi build rejects user=/group= config keys; stay root via --no-drop-root.
    printf '\n# start iface=%s\n' "$iface" >>/var/log/g21-avahi.log
    if start_avahi_bin "$dir" "$conf"; then
        return 0
    fi
    # Fallback without D-Bus if the bus rejects ownership.
    cat > "$conf" <<EOF
[server]
host-name=G21
use-ipv4=yes
use-ipv6=no
allow-interfaces=$iface
deny-interfaces=lo
enable-dbus=no
check-response-ttl=no
use-iff-running=yes
[wide-area]
enable-wide-area=no
[publish]
disable-publishing=no
publish-addresses=yes
publish-hinfo=no
publish-workstation=no
publish-domain=yes
[reflector]
enable-reflector=no
[rlimits]
EOF
    printf '\n# fallback no-dbus iface=%s\n' "$iface" >>/var/log/g21-avahi.log
    if start_avahi_bin "$dir" "$conf"; then
        return 0
    fi
    return 1
}

start_present() {
    dir=$(tool_dir)
    bin=$dir/g21-present
    if [ ! -x "$bin" ]; then
        return 0
    fi
    if [ -n "$PREPID" ] && kill -0 "$PREPID" 2>/dev/null; then
        return 0
    fi
    PREPID=
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/wayland}"
    export LD_LIBRARY_PATH="$(tool_lib_path)"
    export GST_PLUGIN_PATH="$dir/lib/gstreamer-1.0"
    export GST_PLUGIN_SYSTEM_PATH="$dir/lib/gstreamer-1.0"
    export GST_PLUGIN_SYSTEM_PATH_1_0="$dir/lib/gstreamer-1.0"
    if [ -x "$dir/gst-plugin-scanner" ]; then
        export GST_PLUGIN_SCANNER="$dir/gst-plugin-scanner"
    fi
    if [ -x "$dir/run-elf" ]; then
        "$dir/run-elf" "$bin" >>/var/log/g21-present.log 2>&1 &
    else
        "$bin" >>/var/log/g21-present.log 2>&1 &
    fi
    PREPID=$!
}

start_rdp() {
    dir=$(tool_dir)
    bin=$dir/g21-rdp
    cur=
    if [ ! -x "$bin" ]; then
        desk "missing|rdp|"
        return 0
    fi
    if [ -n "$RDPID" ] && kill -0 "$RDPID" 2>/dev/null; then
        # Do not clobber connected|cert|error from g21-rdp — that made the UI
        # show "running" with a blank screen.
        chmod 666 "$DESKTOP" 2>/dev/null || true
        return 0
    fi
    RDPID=
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/wayland}"
    export LD_LIBRARY_PATH="$(tool_lib_path)"
    export WLOG_LEVEL="${WLOG_LEVEL:-INFO}"
    : >>/var/log/g21-rdp.log
    chmod 666 /var/log/g21-rdp.log 2>/dev/null || true
    # g21-rdp needs bundled libfreerdp2; always use run-elf library path.
    if [ -x "$dir/run-elf" ]; then
        "$dir/run-elf" "$bin" >>/var/log/g21-rdp.log 2>&1 &
    else
        "$bin" >>/var/log/g21-rdp.log 2>&1 &
    fi
    RDPID=$!
    sleep 1
    if ! kill -0 "$RDPID" 2>/dev/null; then
        RDPID=
        # Keep g21-rdp's own error|connect| / error|freerdp| / cert|… if present.
        cur=$(tr -d '\r\n' < "$DESKTOP" 2>/dev/null || true)
        case $cur in
            error\|*|cert\|*) ;;
            *) desk "error|rdp|" ;;
        esac
        return 0
    fi
    chmod 666 "$DESKTOP" 2>/dev/null || true
    cur=$(tr -d '\r\n' < "$DESKTOP" 2>/dev/null || true)
    case $cur in
        connecting\|*|connected\|*|cert\|*|error\|*|starting\|*) ;;
        *) desk "starting|rdp|" ;;
    esac
}

stop_present() {
    stop_pid "$PREPID"
    wait_pid_gone "$PREPID"
    PREPID=
    pkill -f '/g21-present' 2>/dev/null || true
    n=0
    while [ "$n" -lt 20 ] && pgrep -f '/g21-present' >/dev/null 2>&1; do
        sleep 0.1
        n=$((n + 1))
    done
    if pgrep -f '/g21-present' >/dev/null 2>&1; then
        pkill -9 -f '/g21-present' 2>/dev/null || true
        sleep 0.2
    fi
    # Free the bind so app frame_bridge can listen for cluster/HUD.
    rm -f /run/g21-desktop/frame.sock 2>/dev/null || true
}

stop_rdp() {
    stop_pid "$RDPID"
    wait_pid_gone "$RDPID"
    RDPID=
    pkill -f '/g21-rdp' 2>/dev/null || true
}

stop_mice() {
    stop_pid "$MICEPID"
    MICEPID=
    pkill -f '/g21-mice' 2>/dev/null || true
}

ensure_avahi_services_dir() {
    src=/etc/avahi/services
    dst=/run/g21-airplay/avahi-etc-services
    mkdir -p "$dst"
    mkdir -p /etc/avahi 2>/dev/null || true
    if [ ! -d "$src" ]; then
        mkdir -p "$src" 2>/dev/null || true
    fi
    if [ -d "$src" ] && ! grep -q ' /etc/avahi/services ' /proc/mounts 2>/dev/null; then
        cp "$src"/* "$dst"/ 2>/dev/null || true
        mount --bind "$dst" "$src" || return 1
    fi
    return 0
}

# MS-MICE requires TXT container_id=<GUID> or Win+K on Windows 11 skips the sink.
mice_container_id() {
    idfile=/run/g21-airplay/mice-container.id
    if [ -f "$idfile" ]; then
        tr -d '\r\n' < "$idfile"
        return 0
    fi
    mkdir -p /run/g21-airplay
    if [ -r /proc/sys/kernel/random/uuid ]; then
        tr -d '\r\n' < /proc/sys/kernel/random/uuid > "$idfile"
    else
        printf '00000000-0000-4000-8000-%012d\n' "$$$(date +%s)" > "$idfile"
    fi
    tr -d '\r\n' < "$idfile"
}

reload_avahi_services() {
    # Avahi picks up new .service files after HUP / short restart of our daemon.
    if [ -n "$AVAHIPID" ] && kill -0 "$AVAHIPID" 2>/dev/null; then
        kill -HUP "$AVAHIPID" 2>/dev/null || true
        return 0
    fi
    if pidof avahi-daemon >/dev/null 2>&1; then
        kill -HUP "$(pidof avahi-daemon | awk '{print $1}')" 2>/dev/null || true
    fi
}

publish_mice_service() {
    shown=$(name_of)
    guid=$(mice_container_id)
    ensure_avahi_services_dir || true
    services=/run/g21-airplay/avahi-etc-services
    mkdir -p "$services"
    # Also write into the live /etc/avahi/services if bind-mounted.
    for svcdir in /run/g21-airplay/avahi-etc-services /etc/avahi/services; do
        [ -d "$svcdir" ] || continue
        cat > "$svcdir/g21-windows.service" <<EOF
<?xml version="1.0" standalone='no'?><!--*-nxml-*-->
<!DOCTYPE service-group SYSTEM "avahi-service.dtd">
<service-group>
  <name replace-wildcards="yes">$shown</name>
  <service>
    <type>_display._tcp</type>
    <port>7250</port>
    <txt-record>container_id=$guid</txt-record>
  </service>
</service-group>
EOF
    done
    reload_avahi_services
}

clear_mice_service() {
    rm -f /run/g21-airplay/avahi-etc-services/g21-windows.service 2>/dev/null || true
    rm -f /run/g21-airplay/avahi-services/g21-windows.service 2>/dev/null || true
    rm -f /etc/avahi/services/g21-windows.service 2>/dev/null || true
    reload_avahi_services
}

start_mice() {
    dir=$(tool_dir)
    bin=$dir/g21-mice
    if [ ! -x "$bin" ]; then
        desk "missing|windows|"
        report "missing|windows|"
        return 0
    fi
    if [ -n "$MICEPID" ] && kill -0 "$MICEPID" 2>/dev/null; then
        desk "waiting|windows|"
        report "running|windows|"
        return 0
    fi
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/wayland}"
    export LD_LIBRARY_PATH="$(tool_lib_path)"
    export GST_PLUGIN_PATH="$dir/lib/gstreamer-1.0"
    export GST_PLUGIN_SYSTEM_PATH="$dir/lib/gstreamer-1.0"
    export GST_PLUGIN_SYSTEM_PATH_1_0="$dir/lib/gstreamer-1.0"
    export PATH="$dir:$PATH"
    if [ -x "$dir/gst-plugin-scanner" ]; then
        export GST_PLUGIN_SCANNER="$dir/gst-plugin-scanner"
    fi
    clear_mice_offers
    publish_mice_service
    : >>/var/log/g21-mice.log
    if [ -x "$dir/run-elf" ]; then
        "$dir/run-elf" "$bin" >>/var/log/g21-mice.log 2>&1 &
    else
        "$bin" >>/var/log/g21-mice.log 2>&1 &
    fi
    MICEPID=$!
    sleep 1
    if kill -0 "$MICEPID" 2>/dev/null; then
        desk "waiting|windows|"
        report "running|windows|"
    else
        MICEPID=
        desk "error|windows|"
        report "uxplay-exit|windows|"
    fi
}

ux_log_has_mdns_error() {
    if [ ! -f "$UXLOG" ]; then
        return 1
    fi
    tail -n 80 "$UXLOG" 2>/dev/null | grep -E 'DNSServiceRegister|kDNSServiceErr|dnssd_error|No DNS-SD' >/dev/null 2>&1
}

start_ux() {
    iface=$1
    label=$2
    ip=$3
    shown=$4
    dir=$(tool_dir)
    bin=$(find_ux) || true
    if [ -z "$bin" ]; then
        stop_ux
        report "missing|$label|$ip"
        return 0
    fi
    # Recover PID after tool restart (g21-detach/exec chain).
    if [ -z "$UXPID" ] || ! kill -0 "$UXPID" 2>/dev/null; then
        UXPID=
        for p in $(our_uxplay_pids); do
            UXPID=$p
            break
        done
    fi
    if [ -n "$UXPID" ] && kill -0 "$UXPID" 2>/dev/null; then
        if ux_log_has_mdns_error; then
            stop_ux
            report "mdns-brak|$label|$ip"
            return 0
        fi
        # Living process: port is the source of truth. "Stopping RAOP" in a prior
        # generation must not kill a healthy listener (log is truncated on start).
        if ! ux_port_listening; then
            stop_ux
            report "uxplay-exit|$label|$ip"
            return 0
        fi
        # DNS-SD lives in avahi: if it died/restarted after UxPlay registered,
        # the phone still sees a stale name and spins with zero TCP to :7401.
        # Keep avahi up; bounce UxPlay when the daemon instance changed.
        old_avahi=
        if [ -n "$AVAHIPID" ] && kill -0 "$AVAHIPID" 2>/dev/null; then
            old_avahi=$AVAHIPID
        elif recover_avahi_pid; then
            old_avahi=$AVAHIPID
        fi
        if ! ensure_mdns "$iface"; then
            report "mdns-brak|$label|$ip"
            return 0
        fi
        if [ -z "$old_avahi" ] || [ "$old_avahi" != "$AVAHIPID" ]; then
            stop_ux
            # Fall through and start a fresh UxPlay so register_dnssd runs again.
        else
            report "running|$label|$ip"
            return 0
        fi
    fi
    # UxPlay is linked to libdns_sd.so.1 (Avahi compat) and also dlopen("libdns_sd.so").
    # BMW mdnsd + /usr/lib/libdns_sd.so accept the call but return kDNSServiceErr_Unknown
    # for this third-party client → UI "brak dns". Always run bundled avahi and force
    # the tool's libdns_sd ahead of /usr/lib (symlink .so → .so.1 for dlopen).
    if ! ensure_mdns "$iface"; then
        report "mdns-brak|$label|$ip"
        return 0
    fi
    if [ -f "$dir/lib/libdns_sd.so.1" ]; then
        ln -sfn libdns_sd.so.1 "$dir/lib/libdns_sd.so" 2>/dev/null || true
    fi
    export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/wayland}"
    export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
    export LD_LIBRARY_PATH="$(tool_lib_path)"
    export GST_PLUGIN_PATH="$dir/lib/gstreamer-1.0"
    export GST_PLUGIN_SYSTEM_PATH="$dir/lib/gstreamer-1.0"
    export GST_PLUGIN_SYSTEM_PATH_1_0="$dir/lib/gstreamer-1.0"
    export GST_REGISTRY="${GST_REGISTRY:-/run/g21-airplay/registry.bin}"
    if [ -x "$dir/gst-plugin-scanner" ]; then
        export GST_PLUGIN_SCANNER="$dir/gst-plugin-scanner"
    fi
    export G21_YUV=/run/g21-airplay/latest.yuv
    export AVAHI_COMPAT_NOWARN=1
    mkdir -p /run/g21-airplay
    mac=$(iface_mac "$iface")
    mac_args=
    if [ -n "$mac" ]; then
        mac_args="-m $mac"
    fi
    : > "$UXLOG"
    # Do not pass -fs: MGU waylandsink has no "fullscreen" property and UxPlay
    # aborts the RAOP server, so the iPhone never sees G21 in AirPlay.
    # -vs fakesink: decode + G21_YUV tee only; app presents via g21-present / cluster-render.
    # Direct waylandsink under HMI is blank (H13/H30). Keep G21_YUV export above.
    # -p 7400 avoids CarPlay TCP 7000 / airplay-rx 7101 (errno 98 on this unit).
    # With -p 7400 the RAOP/AirPlay httpd listens on TCP 7401 (see ux_port_listening).
    # -as 0: alsasink GST errors quit the RAOP main loop on this unit; video-only mirror.
    # -pin NNNN: Apple Screen Mirroring pairing (PAIR-PIN-START). -pw digest often
    # never shows a prompt on modern iOS and the connect fails before any UI.
    # -d 1: debug to UXLOG (line-buffered via stdbuf when available).
    # Write PINFILE before start so the stream window can show the code immediately.
    # New session via g21-detach (libc setsid): BusyBox on this MGU has no setsid
    # applet, so plain `setsid` aborted start with "not found" and left no listener.
    # Helper is a static ELF so it runs without /lib64. Fall back to nohup.
    # shellcheck disable=SC2086
    clear_pin
    pin=$(awk 'BEGIN { srand(); printf "%04d", 1000 + int(rand() * 9000) }')
    mkdir -p /run/g21-airplay
    printf '%s\n' "$pin" > "$PINFILE"
    chmod 666 "$PINFILE" 2>/dev/null || true
    if [ -n "$mac_args" ]; then
        set -- -n "$shown" -nh -p 7400 $mac_args -vsync no -vs fakesink -as 0 -s 1920x720 -pin "$pin" -d 1
    else
        set -- -n "$shown" -nh -p 7400 -vsync no -vs fakesink -as 0 -s 1920x720 -pin "$pin" -d 1
    fi
    printf '%s\n' "$*" > /run/g21-airplay/ux.cmd
    # Run under a tiny shell wrapper so stdout is line-buffered into UXLOG
    # (plain redirect is fully buffered; empty logs hide DNS-SD / connect errors).
    ux_wrap=/run/g21-airplay/ux-wrap.sh
    {
        printf '%s\n' '#!/bin/sh'
        printf '%s\n' 'export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:-}"'
        printf '%s\n' 'bin="$1"; shift'
        printf '%s\n' 'if command -v stdbuf >/dev/null 2>&1; then'
        printf '%s\n' '  exec stdbuf -oL -eL "$bin" "$@"'
        printf '%s\n' 'fi'
        printf '%s\n' 'exec "$bin" "$@"'
    } > "$ux_wrap"
    chmod 755 "$ux_wrap" 2>/dev/null || true
    if [ -x "$dir/g21-detach" ]; then
        "$dir/g21-detach" "$ux_wrap" "$bin" "$@" >>"$UXLOG" 2>&1 &
    elif command -v nohup >/dev/null 2>&1; then
        nohup "$ux_wrap" "$bin" "$@" >>"$UXLOG" 2>&1 &
    else
        "$ux_wrap" "$bin" "$@" >>"$UXLOG" 2>&1 &
    fi
    UXPID=$!
    # Prefer the real uxplay.bin PID after detach/exec chain; wait for :7401.
    n=0
    while [ "$n" -lt 10 ]; do
        for p in $(our_uxplay_pids); do
            UXPID=$p
            break
        done
        if [ -n "$UXPID" ] && kill -0 "$UXPID" 2>/dev/null && ux_port_listening; then
            break
        fi
        sleep 1
        n=$((n + 1))
    done
    for p in $(our_uxplay_pids); do
        UXPID=$p
        break
    done
    if [ -z "$UXPID" ] || ! kill -0 "$UXPID" 2>/dev/null; then
        UXPID=
        clear_pin
        if ux_log_has_mdns_error; then
            report "mdns-brak|$label|$ip"
        else
            report "uxplay-exit|$label|$ip"
        fi
        return 0
    fi
    if ux_log_has_mdns_error; then
        stop_ux
        report "mdns-brak|$label|$ip"
        return 0
    fi
    if grep -E 'gst_parse_launch failed|no property \"fullscreen\"|Error initialising socket|Required gstreamer plugin' "$UXLOG" >/dev/null 2>&1; then
        stop_ux
        report "uxplay-exit|$label|$ip"
        return 0
    fi
    if ! ux_port_listening; then
        stop_ux
        report "uxplay-exit|$label|$ip"
        return 0
    fi
    watch_ux_pin "$UXPID" &
    PINWATCH=$!
    report "running|$label|$ip"
}

apply_airplay() {
    shown=$(name_of)
    uplink=$(find_uplink_wifi) || {
        idle
        report "idle|brak-wifi|"
        return 0
    }
    set -- $uplink
    iface=$1
    ip=$2
    prefix=$3
    label=$4
    net=$(subnet "$ip" "$prefix") || { idle; report "idle|bad-prefix|"; return 0; }
    stamp="uplink $iface $net"
    clear_mice_if_needed
    if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$stamp" ]; then
        stop_ux
        # Keep bundled avahi if already up for this Wi-Fi; killing it every stamp
        # change raced UxPlay DNS-SD (SIGTERM in g21-avahi.log).
        open_ports "$iface" "$net" "$ip"
        printf '%s\n' "$stamp" > "$STAMP"
    fi
    # Re-assert on-link route every apply: mgu-uplink may strip it again.
    if [ -n "$net" ] && [ -n "$ip" ]; then
        ip route replace "$net" dev "$iface" src "$ip" 2>/dev/null || true
    fi
    start_ux "$iface" "$label" "$ip" "$shown"
}

apply_windows() {
    shown=$(name_of)
    uplink=$(find_uplink_wifi) || {
        idle
        report "idle|brak-wifi|"
        return 0
    }
    set -- $uplink
    iface=$1
    ip=$2
    prefix=$3
    label=$4
    net=$(subnet "$ip" "$prefix") || { idle; report "idle|bad-prefix|"; return 0; }
    stamp="windows $iface $net"
    stop_ux
    stop_present
    stop_rdp
    if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$stamp" ]; then
        stop_mice
        stop_avahi_local
        open_ports "$iface" "$net" "$ip"
        printf '%s\n' "$stamp" > "$STAMP"
    fi
    if [ -n "$net" ] && [ -n "$ip" ]; then
        ip route replace "$net" dev "$iface" src "$ip" 2>/dev/null || true
    fi
    if ! ensure_mdns "$iface"; then
        report "mdns-brak|$label|$ip"
        desk "error|mdns|"
        return 0
    fi
    publish_mice_service
    start_mice
}

apply_uplink_desktop() {
    kind=$(field kind "$STATUS")
    link=$(field link "$STATUS")
    iface=$(field interface "$LEASE")
    ip=$(field ip "$LEASE")
    prefix=$(number prefix "$LEASE")
    case $kind in
        wifi) ;;
        *) idle; report "idle|uplink-not-wifi|"; return 1 ;;
    esac
    case $link in
        online|connected) ;;
        *) idle; report "idle|wifi-down|"; return 1 ;;
    esac
    case $iface in
        ""|*[!A-Za-z0-9._-]*) idle; report "idle|bad-interface|"; return 1 ;;
    esac
    net=$(subnet "$ip" "$prefix") || { idle; report "idle|bad-prefix|"; return 1; }
    stamp="desk $iface $net"
    if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$stamp" ]; then
        open_ports "$iface" "$net" "$ip"
        printf '%s\n' "$stamp" > "$STAMP"
    fi
    if [ -n "$net" ] && [ -n "$ip" ]; then
        ip route replace "$net" dev "$iface" src "$ip" 2>/dev/null || true
    fi
    return 0
}

keep_config_ports() {
    uplink=$(find_uplink_wifi) || {
        clear_table
        rm -f "$STAMP"
        return 1
    }
    set -- $uplink
    iface=$1
    ip=$2
    prefix=$3
    net=$(subnet "$ip" "$prefix") || return 1
    stamp="cfg $iface $net"
    if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP")" != "$stamp" ]; then
        open_ports "$iface" "$net" "$ip"
        printf '%s\n' "$stamp" > "$STAMP"
    fi
    if [ -n "$net" ] && [ -n "$ip" ]; then
        ip route replace "$net" dev "$iface" src "$ip" 2>/dev/null || true
    fi
    return 0
}

apply() {
    ensure_dirs
    mode=$(mode_of)
    case $mode in
        airplay)
            stop_rdp
            clear_mice_if_needed
            # central = g21-present reads BGRA from app; cluster/hud = cluster-render atlas
            out=$(tr -d '\r\n' < "$SESSION_DIR/output" 2>/dev/null || true)
            if [ "$out" = "cluster" ] || [ "$out" = "hud" ]; then
                stop_present
            else
                start_present
            fi
            apply_airplay
            ;;
        windows)
            apply_windows
            ;;
        vnc)
            stop_ux
            stop_rdp
            clear_mice_if_needed
            if apply_uplink_desktop; then
                start_present
                desk "running|vnc|"
                report "idle|session-vnc|"
            fi
            ;;
        rdp)
            stop_ux
            clear_mice_if_needed
            if apply_uplink_desktop; then
                # central = g21-present on Wayland; cluster/hud = app listens on frame.sock
                out=$(tr -d '\r\n' < "$SESSION_DIR/output" 2>/dev/null || true)
                if [ "$out" = "cluster" ] || [ "$out" = "hud" ]; then
                    stop_present
                    # Wait until present is gone so bridge bind does not hit EADDRINUSE.
                    n=0
                    while [ "$n" -lt 30 ] && ! frame_sock_free; do
                        sleep 0.1
                        n=$((n + 1))
                    done
                else
                    start_present
                fi
                start_rdp
                report "idle|session-rdp|"
            fi
            ;;
        *)
            stop_ux
            stop_present
            stop_rdp
            clear_mice_if_needed
            stop_bundled_avahi
            if keep_config_ports; then
                report "idle|session-off|"
            else
                clear_table
                rm -f "$STAMP"
                report "idle|session-off|"
            fi
            ;;
    esac
}

stop() {
    stop_ux
    stop_present
    stop_rdp
    stop_mice
    clear_mice_service
    stop_bundled_avahi
    clear_table
    rm -f "$STAMP"
    report "idle|stopped|"
    exit 0
}

trap stop TERM INT
while true; do
    apply
    # 1s so allow=stop → cluster bridge wins frame.sock before the next rdp start.
    sleep 1
done
