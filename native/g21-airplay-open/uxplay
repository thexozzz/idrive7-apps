#!/bin/sh
# Starts the bundled UxPlay binary with the libraries next to this script.
dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
# Prefer tool libdns_sd.so.1 (Avahi) over BMW /usr/lib/libdns_sd.so — Bonjour
# DNSServiceRegister returns kDNSServiceErr_Unknown for this UxPlay build.
if [ -f "$dir/lib/libdns_sd.so.1" ]; then
    ln -sfn libdns_sd.so.1 "$dir/lib/libdns_sd.so" 2>/dev/null || true
fi
export LD_LIBRARY_PATH="$dir/lib:/usr/lib:/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GST_PLUGIN_PATH="$dir/lib/gstreamer-1.0"
export GST_PLUGIN_SYSTEM_PATH="$dir/lib/gstreamer-1.0"
export GST_PLUGIN_SYSTEM_PATH_1_0="$dir/lib/gstreamer-1.0"
if [ -x "$dir/gst-plugin-scanner" ]; then
    export GST_PLUGIN_SCANNER="$dir/gst-plugin-scanner"
fi
export GST_REGISTRY="${GST_REGISTRY:-/run/g21-airplay/registry.bin}"
export AVAHI_COMPAT_NOWARN=1
exec "$dir/run-elf" "$dir/uxplay.bin" "$@"
